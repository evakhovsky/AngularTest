                  "items": {
                    "$ref": "#/components/schemas/GenealogyNodeDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GenealogyNodeDto"
